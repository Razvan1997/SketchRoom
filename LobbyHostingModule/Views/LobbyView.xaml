<UserControl
    x:Class="LobbyHostingModule.Views.LobbyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SketchRoom.Toolkit.Wpf.Controls;assembly=SketchRoom.Toolkit.Wpf"
    xmlns:conv="clr-namespace:SketchRoom.Toolkit.Wpf.Converters;assembly=SketchRoom.Toolkit.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LobbyHostingModule.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EncryptedDataToImageConverter x:Key="AvatarConverter" />
    </UserControl.Resources>

    <Grid Background="#1f1f1f">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Create room  -->
        <Border
            Grid.Row="0"
            Margin="10"
            Padding="14"
            Background="#2e2e2e"
            CornerRadius="8">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Create a room" />

                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Margin="0,0,16,0"
                        Content="Online"
                        Foreground="White"
                        GroupName="HostMode"
                        IsChecked="{Binding IsOnlineMode, Mode=TwoWay}" />
                    <RadioButton
                        Content="LAN (this network)"
                        Foreground="White"
                        GroupName="HostMode"
                        IsChecked="{Binding IsLanMode, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsOnlineMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="#bdbdbd" Text="Online server URL" />
                    <TextBox Margin="0,2,0,0" Text="{Binding CentralServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <controls:ActionButton
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    ButtonCommand="{Binding CreateRoomCommand}"
                    ButtonText="Create room" />

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="#ffd54f"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Room info + host controls (visible once hosting)  -->
        <Border
            Grid.Row="1"
            Margin="10,0,10,10"
            Padding="14"
            Background="#2e2e2e"
            CornerRadius="8"
            Visibility="{Binding IsHosting, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Foreground="#bdbdbd" Text="Room code" />
                <TextBlock
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding SessionCode}" />

                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsLanMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="#bdbdbd" Text="LAN address (others join with this)" />
                    <TextBlock
                        FontSize="14"
                        Foreground="White"
                        Text="{Binding LanAddress}" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <controls:ActionButton
                        Margin="0,0,8,0"
                        ButtonCommand="{Binding StartSessionCommand}"
                        ButtonText="Start session" />
                    <controls:ActionButton
                        Margin="0,0,8,0"
                        ButtonCommand="{Binding ToggleLockCommand}"
                        ButtonText="{Binding LockButtonText}" />
                    <controls:ActionButton
                        ButtonCommand="{Binding ClearBoardCommand}"
                        ButtonText="Clear board" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Participants with host moderation  -->
        <Grid Grid.Row="2" Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,6"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                Text="Participants" />

            <ItemsControl Grid.Row="1" ItemsSource="{Binding ConnectedParticipants}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,4"
                            Padding="8"
                            Background="#2e2e2e"
                            CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="32"
                                    Height="32"
                                    Background="Gray"
                                    ClipToBounds="True"
                                    CornerRadius="16">
                                    <Image
                                        Source="{Binding AvatarBase64, Converter={StaticResource AvatarConverter}}"
                                        Stretch="UniformToFill" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock Foreground="White" Text="{Binding DisplayName}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="#bdbdbd"
                                        Text="(host)"
                                        Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    Padding="8,2"
                                    Background="#b71c1c"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.KickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding UserId}"
                                    Content="Kick"
                                    Cursor="Hand"
                                    Foreground="White"
                                    Visibility="{Binding CanKick, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
